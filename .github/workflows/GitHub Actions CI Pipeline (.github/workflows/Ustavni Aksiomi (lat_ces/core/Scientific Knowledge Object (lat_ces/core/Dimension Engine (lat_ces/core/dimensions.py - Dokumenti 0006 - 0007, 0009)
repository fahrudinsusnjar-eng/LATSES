"""
LAT-CES Core: Dimension Engine (SI Base Units Algebra)
Dokumenti: LAT-SCI-CORE-0006 do LAT-SCI-CORE-0009
"""
from dataclasses import dataclass

@dataclass(frozen=True)
class Dimension:
    # 7 Osnovnih SI Dimenzija: L, M, T, I, Theta, N, J
    L: int = 0  # Dužina (m)
    M: int = 0  # Masa (kg)
    T: int = 0  # Vrijeme (s)
    I: int = 0  # Električna struja (A)
    Theta: int = 0 # Termodinamička temperatura (K)
    N: int = 0  # Količina tvari (mol)
    J: int = 0  # Jačina svjetlosti (cd)

    def __mul__(self, other: 'Dimension') -> 'Dimension':
        return Dimension(
            L=self.L + other.L,
            M=self.M + other.M,
            T=self.T + other.T,
            I=self.I + other.I,
            Theta=self.Theta + other.Theta,
            N=self.N + other.N,
            J=self.J + other.J
        )

    def __truediv__(self, other: 'Dimension') -> 'Dimension':
        return Dimension(
            L=self.L - other.L,
            M=self.M - other.M,
            T=self.T - other.T,
            I=self.I - other.I,
            Theta=self.Theta - other.Theta,
            N=self.N - other.N,
            J=self.J - other.J
        )

    def is_dimensionless(self) -> bool:
        return all(v == 0 for v in [self.L, self.M, self.T, self.I, self.Theta, self.N, self.J])

# Bazne konstante dimenzija
DIMENSIONLESS = Dimension()
LENGTH = Dimension(L=1)
MASS = Dimension(M=1)
TIME = Dimension(T=1)
VELOCITY = Dimension(L=1, T=-1)
ACCELERATION = Dimension(L=1, T=-2)
FORCE = Dimension(M=1, L=1, T=-2)
